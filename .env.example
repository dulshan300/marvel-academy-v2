APP_NAME="Marvel Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Services run in Docker (docker compose up -d) and are reached from the
# host on 127.0.0.1. If the app itself runs inside the compose network,
# use the service names instead: pgsql, redis, minio, mailpit.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marvel_academy
DB_USERNAME=marvel
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@marvelacademy.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible). Console: http://localhost:9001
AWS_ACCESS_KEY_ID=marvel
AWS_SECRET_ACCESS_KEY=marvel-secret
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=marvel-academy
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/marvel-academy
AWS_USE_PATH_STYLE_ENDPOINT=true

BACKUP_DISK=backups
BACKUP_BUCKET=marvel-academy-backups
BACKUP_NOTIFICATION_EMAIL=admin@marvelacademy.co.uk

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

VITE_APP_NAME="${APP_NAME}"
